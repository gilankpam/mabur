diff --git a/mpp/hal/inc/mpp_hal.h b/mpp/hal/inc/mpp_hal.h
index 9245312..124d404 100644
--- a/mpp/hal/inc/mpp_hal.h
+++ b/mpp/hal/inc/mpp_hal.h
@@ -28,6 +28,13 @@
 #include "mpp_dec_cfg.h"
 #include "mpp_device.h"
 
+/*
+ * fpvOS: a MppDecStreamAppend flag of MPP's own, never a caller's
+ * (mpp_dec_stream_control clears it): end the streamed picture that is open,
+ * whatever its pts, and each one that opens until the hal is reset.
+ */
+#define MPP_STREAM_APPEND_STOP          (0x80000000)
+
 typedef enum VpuHwMode_e {
     MODE_NULL   = 0,
     RKVDEC_MODE = 0x01,
diff --git a/mpp/hal/rkdec/h265d/hal_h265d_ctx.h b/mpp/hal/rkdec/h265d/hal_h265d_ctx.h
index f4abdf8..d5fb5e4 100644
--- a/mpp/hal/rkdec/h265d/hal_h265d_ctx.h
+++ b/mpp/hal/rkdec/h265d/hal_h265d_ctx.h
@@ -89,6 +89,9 @@ typedef struct HalH265dCtx_t {
     RK_U32          ps_buf_init;
 
     HalDbgCtx       *dbg_ctx;
+
+    /* fpvOS: pictures streamed in slice by slice (vdpu34x only) */
+    void            *strm;
 } HalH265dCtx;
 
 typedef struct ScalingList_t {
diff --git a/mpp/hal/rkdec/h265d/hal_h265d_vdpu34x.c b/mpp/hal/rkdec/h265d/hal_h265d_vdpu34x.c
index 7d8ce40..c1bb43c 100644
--- a/mpp/hal/rkdec/h265d/hal_h265d_vdpu34x.c
+++ b/mpp/hal/rkdec/h265d/hal_h265d_vdpu34x.c
@@ -98,6 +98,429 @@ static const FilterdColBufRatio filterd_fbc_off[CTU][FMT] = {
 #define RPS_OFFSET(pos)                 (SPSPPS_OFFSET(pos) + SPSPPS_ALIGNED_SIZE)
 #define SCALIST_OFFSET(pos)             (RPS_OFFSET(pos) + RPS_ALIGEND_SIZE)
 
+/*
+ * fpvOS: pictures decoded as their slices arrive.
+ *
+ * A packet with MPP_PACKET_FLAG_STREAM_START holds a picture's first slice;
+ * the hardware is started on it in stream mode (h26x_stream_mode, no
+ * lastpacket), and the fpvOS kernel holds the decoder when that data runs out.
+ * Each later slice comes by MPP_DEC_SET_STREAM_APPEND on the caller's thread:
+ * it is copied into the picture's stream buffer behind the data before it and
+ * handed to the kernel (MPP_DEV_STREAM_APPEND), which feeds it to the
+ * decoder. The vdpu34x parses every slice header itself, so nothing about the
+ * later slices has to be known when the picture starts.
+ *
+ * One picture takes appends at a time: the one sent (start) and not yet
+ * waited for. Appends for a picture the decoder has not been sent yet - the
+ * caller runs ahead of the decode thread - wait in pending, matched by pts.
+ *
+ * A caller sends a picture's parts before the next picture's, so a part of a
+ * later picture says the open one gets no more: it is ended then, not left to
+ * hold the decoder until the kernel's deadline for parts that are not coming.
+ * A reset or stop ends it too (MPP_STREAM_APPEND_STOP).
+ */
+#include <pthread.h>
+
+/*
+ * Appends for pictures MPP holds and has not started: the four packets of its
+ * input queue, one parsed and one waiting for the decoder - eight with room -
+ * of up to 16 parts each (kestrel's have one to four). Full, it drops its
+ * oldest part, in the log; the picture that part belonged to is ended when it
+ * opens, the parts of later pictures being there behind it.
+ */
+#define STRM_PENDING_MAX        128
+
+typedef struct H265dStrmPart_t {
+    RK_S64      pts;
+    RK_U8       *data;
+    RK_U32      size;
+    RK_U32      flags;
+} H265dStrmPart;
+
+typedef struct H265dStrm_t {
+    pthread_mutex_t lock;
+    RK_U32      supported;
+
+    /* prepared by gen_regs, opened by start once it is sent */
+    RK_U32      next_valid;
+    RK_S64      next_pts;
+    MppBuffer   next_buf;
+    RK_U32      next_pos;
+    RK_S32      next_out_fd;
+
+    /* the picture on the decoder that takes appends */
+    RK_U32      open;
+    RK_S64      pts;
+    MppBuffer   buf;
+    RK_U8       *ptr;
+    RK_U32      cap;
+    RK_U32      pos;
+    RK_S32      out_fd;         /* its output buffer, for MPP_DEC_GET_STREAM_TOP */
+
+    /* the newest picture opened: appends naming an older one are late */
+    RK_U32      opened_any;
+    RK_S64      newest_pts;
+
+    H265dStrmPart pending[STRM_PENDING_MAX];
+    RK_U32      pending_cnt;
+    RK_U32      dropped;
+
+    /* a reset or stop is on its way: end what opens, the decode thread waits on it */
+    RK_U32      stopping;
+
+    RK_U32      pictures;
+    RK_U32      late;
+    RK_U32      debug;
+    RK_U32      can_wait;       /* the kernel takes MPP_STREAM_WAIT */
+} H265dStrm;
+
+#define strm_dbg(s, fmt, ...) do { if ((s)->debug) mpp_log("h265d strm: " fmt, ##__VA_ARGS__); } while (0)
+
+static void h265d_strm_init(HalH265dCtx *reg_ctx)
+{
+    H265dStrm *s;
+    MppDevStreamAppend probe;
+    RK_U32 enable = 1;
+
+    mpp_env_get_u32("h265d_stream", &enable, 1);
+    /* fast mode has two pictures in flight; one at a time is what streams */
+    if (!enable || reg_ctx->fast_mode)
+        return;
+
+    memset(&probe, 0, sizeof(probe));
+    probe.flags = MPP_STREAM_PROBE;
+    if (mpp_dev_ioctl(reg_ctx->cfg->dev, MPP_DEV_STREAM_APPEND, &probe) ||
+        probe.result != MPP_STREAM_SUPPORTED)
+        return;
+
+    s = mpp_calloc(H265dStrm, 1);
+    if (!s)
+        return;
+    pthread_mutex_init(&s->lock, NULL);
+    s->supported = 1;
+    /* a kernel without MPP_STREAM_WAIT would take it for an append */
+    s->can_wait = !!(probe.length & MPP_STREAM_CAP_WAIT);
+    mpp_env_get_u32("h265d_stream_debug", &s->debug, 0);
+    reg_ctx->strm = s;
+    mpp_log("h265d: the kernel takes streamed pictures%s\n",
+            s->can_wait ? ", and says when their first part is decoded" : "");
+}
+
+static void h265d_strm_deinit(HalH265dCtx *reg_ctx)
+{
+    H265dStrm *s = (H265dStrm *)reg_ctx->strm;
+    RK_U32 i;
+
+    if (!s)
+        return;
+    for (i = 0; i < s->pending_cnt; i++)
+        MPP_FREE(s->pending[i].data);
+    pthread_mutex_destroy(&s->lock);
+    MPP_FREE(reg_ctx->strm);
+}
+
+/* Under lock, the picture open: put a part behind its data, hand it over. */
+static void h265d_strm_send(HalH265dCtx *reg_ctx, H265dStrm *s,
+                            const void *data, RK_U32 size, RK_U32 flags)
+{
+    MppDevStreamAppend a;
+    RK_U32 pad;
+    RK_U32 last = flags & MPP_STREAM_APPEND_LAST;
+
+    memset(&a, 0, sizeof(a));
+    /*
+     * Zero-padded as gen_regs pads a whole picture's stream (to 16 bytes, and
+     * 64 more): the decoder reads ahead, and a part that ends at its last
+     * byte leaves it waiting for data that never comes. Zeros between NAL
+     * units are allowed (trailing_zero_8bits), so the next part follows them.
+     */
+    pad = MPP_ALIGN(s->pos + size, 16) + 64 - (s->pos + size);
+    if (size && s->pos + size + pad <= s->cap) {
+        memcpy(s->ptr + s->pos, data, size);
+        memset(s->ptr + s->pos + size, 0, pad);
+        mpp_buffer_sync_partial_end(s->buf, s->pos, size + pad);
+        a.offset = s->pos;
+        a.length = size + pad;
+        s->pos += size + pad;
+    } else if (size) {
+        /* no room: what came is all the picture gets */
+        mpp_err("h265d: streamed picture overflows its %d byte buffer\n", s->cap);
+        last = 1;
+    }
+    if (!a.length && !last)
+        return;
+    a.flags = last ? MPP_STREAM_LAST : 0;
+    {
+        MPP_RET r = mpp_dev_ioctl(reg_ctx->cfg->dev, MPP_DEV_STREAM_APPEND, &a);
+
+        strm_dbg(s, "pts %lld append off %u len %u flags %x -> ret %d result %u\n",
+                 (long long)s->pts, a.offset, a.length, a.flags, r, a.result);
+        if (r && !last) {
+            /*
+             * Refused outright - an older kernel's full queue or a range it
+             * does not take - the kernel's picture stays open, the decoder
+             * waiting for a part that will not come: end it. A kernel that
+             * ends a picture whose part it cannot take says so in result.
+             */
+            memset(&a, 0, sizeof(a));
+            a.flags = MPP_STREAM_LAST;
+            r = mpp_dev_ioctl(reg_ctx->cfg->dev, MPP_DEV_STREAM_APPEND, &a);
+            strm_dbg(s, "pts %lld refused: ended -> ret %d result %u\n",
+                     (long long)s->pts, r, a.result);
+            r = MPP_NOK;
+        }
+        if (r || a.result != MPP_STREAM_TAKEN || last)
+            s->open = 0;
+    }
+}
+
+/* gen_regs: a streamed picture starts on its first slice. */
+static void h265d_strm_regs(HalH265dCtx *reg_ctx, Vdpu34xRegSet *regs,
+                            h265d_dxva2_picture_context_t *dxva_cxt, MppBuffer streambuf)
+{
+    H265dStrm *s = (H265dStrm *)reg_ctx->strm;
+    MppFrame mframe = NULL;
+
+    if (!s)
+        return;
+    pthread_mutex_lock(&s->lock);
+    s->next_valid = 0;
+    if (dxva_cxt->stream_slices > dxva_cxt->slice_count && streambuf) {
+        regs->comm_paras.reg64.stream_mode = 1;
+        regs->comm_paras.reg64.stream_lastpacket = 0;
+        regs->comm_gen.reg017.slice_num = dxva_cxt->stream_slices;
+        /* exactly the data there is: the next part follows it */
+        regs->comm_gen.reg016_str_len = dxva_cxt->bitstream_size;
+        /* it counts while the decoder waits: the kernel keeps the watch instead */
+        regs->comm_gen.reg011.dec_timeout_e = 0;
+        /* dec_e may be written again mid-picture: that is how it resumes */
+        regs->comm_gen.reg011.dec_e_rewrite_valid = 1;
+
+        MppBuffer outbuf = NULL;
+
+        mpp_buf_slot_get_prop(reg_ctx->cfg->frame_slots, dxva_cxt->pp.CurrPic.Index7Bits,
+                              SLOT_FRAME_PTR, &mframe);
+        mpp_buf_slot_get_prop(reg_ctx->cfg->frame_slots, dxva_cxt->pp.CurrPic.Index7Bits,
+                              SLOT_BUFFER, &outbuf);
+        s->next_out_fd = outbuf ? mpp_buffer_get_fd(outbuf) : -1;
+        s->next_valid = 1;
+        s->next_pts = mframe ? mpp_frame_get_pts(mframe) : 0;
+        s->next_buf = streambuf;
+        s->next_pos = dxva_cxt->bitstream_size;
+        strm_dbg(s, "regs pts %lld slices %u of %u len %u\n", (long long)s->next_pts,
+                 dxva_cxt->slice_count, dxva_cxt->stream_slices, dxva_cxt->bitstream_size);
+    }
+    pthread_mutex_unlock(&s->lock);
+}
+
+/* start, once the task is sent: the picture takes appends, waiting ones first. */
+static void h265d_strm_sent(HalH265dCtx *reg_ctx)
+{
+    H265dStrm *s = (H265dStrm *)reg_ctx->strm;
+    RK_U32 i, kept = 0;
+
+    if (!s)
+        return;
+    pthread_mutex_lock(&s->lock);
+    if (s->next_valid) {
+        s->next_valid = 0;
+        s->open = 1;
+        s->pts = s->next_pts;
+        s->buf = s->next_buf;
+        s->ptr = (RK_U8 *)mpp_buffer_get_ptr(s->buf);
+        s->cap = (RK_U32)mpp_buffer_get_size(s->buf);
+        s->pos = s->next_pos;
+        s->out_fd = s->next_out_fd;
+        s->opened_any = 1;
+        s->newest_pts = s->pts;
+        s->pictures++;
+        strm_dbg(s, "sent pts %lld, %u waiting\n", (long long)s->pts, s->pending_cnt);
+    }
+    for (i = 0; i < s->pending_cnt; i++) {
+        H265dStrmPart *p = &s->pending[i];
+
+        if (s->opened_any && p->pts <= s->newest_pts) {
+            if (s->open && p->pts == s->pts)
+                h265d_strm_send(reg_ctx, s, p->data, p->size, p->flags);
+            MPP_FREE(p->data);
+        } else {
+            s->pending[kept++] = *p;
+        }
+    }
+    s->pending_cnt = kept;
+    /*
+     * Parts of a later picture wait behind it, or a reset is on its way: what
+     * has not come of this one never will. End it now.
+     */
+    if (s->open && (kept || s->stopping)) {
+        strm_dbg(s, "pts %lld ended at once: %u later parts waiting, stopping %u\n",
+                 (long long)s->pts, kept, s->stopping);
+        h265d_strm_send(reg_ctx, s, NULL, 0, MPP_STREAM_APPEND_LAST);
+    }
+    pthread_mutex_unlock(&s->lock);
+}
+
+/* wait: the picture is done, whatever of it has not come is too late. */
+static void h265d_strm_done(HalH265dCtx *reg_ctx)
+{
+    H265dStrm *s = (H265dStrm *)reg_ctx->strm;
+
+    if (!s)
+        return;
+    pthread_mutex_lock(&s->lock);
+    strm_dbg(s, "done pts %lld (open %u)\n", (long long)s->pts, s->open);
+    s->open = 0;
+    pthread_mutex_unlock(&s->lock);
+}
+
+/* a decoder reset: nothing is open, nothing waits, pts may start over */
+static void h265d_strm_reset(HalH265dCtx *reg_ctx)
+{
+    H265dStrm *s = (H265dStrm *)reg_ctx->strm;
+    RK_U32 i;
+
+    if (!s)
+        return;
+    pthread_mutex_lock(&s->lock);
+    for (i = 0; i < s->pending_cnt; i++)
+        MPP_FREE(s->pending[i].data);
+    s->pending_cnt = 0;
+    s->next_valid = 0;
+    s->open = 0;
+    s->opened_any = 0;
+    s->stopping = 0;
+    pthread_mutex_unlock(&s->lock);
+}
+
+/* MPP_DEC_GET_STREAM_TOP, on the caller's thread */
+static MPP_RET h265d_strm_top(HalH265dCtx *reg_ctx, MppDecStreamTop *t)
+{
+    H265dStrm *s = (H265dStrm *)reg_ctx->strm;
+    MppDevStreamAppend a;
+    struct timespec ts;
+    RK_S64 now, end;
+    RK_S32 fd = -1;
+
+    if (!s || !t || !s->can_wait)
+        return MPP_NOK;
+    t->state = MPP_STREAM_TOP_NONE;
+    t->buf_fd = -1;
+    t->time_us = 0;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    now = ts.tv_sec * 1000000LL + ts.tv_nsec / 1000;
+    end = now + (RK_S64)t->timeout_ms * 1000;
+
+    /* the picture has to be on the decoder: the decode thread may not have sent it yet */
+    for (;;) {
+        RK_U32 gone;
+
+        pthread_mutex_lock(&s->lock);
+        if (s->open && s->pts == t->pts)
+            fd = s->out_fd;
+        gone = fd < 0 && s->opened_any && s->newest_pts >= t->pts;
+        pthread_mutex_unlock(&s->lock);
+        if (fd >= 0)
+            break;
+        if (gone) {
+            t->state = MPP_STREAM_TOP_DONE;
+            return MPP_OK;
+        }
+        if (now >= end)
+            return MPP_OK;
+        usleep(200);
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        now = ts.tv_sec * 1000000LL + ts.tv_nsec / 1000;
+    }
+
+    /* then the kernel says when it has decoded what it has */
+    memset(&a, 0, sizeof(a));
+    a.flags = MPP_STREAM_WAIT;
+    a.length = end > now ? (RK_U32)((end - now + 999) / 1000) : 1;
+    if (mpp_dev_ioctl(reg_ctx->cfg->dev, MPP_DEV_STREAM_APPEND, &a))
+        return MPP_OK;
+    if (a.result == MPP_STREAM_PAUSED) {
+        t->state = MPP_STREAM_TOP_READY;
+        t->buf_fd = fd;
+        t->time_us = (RK_S64)a.time_us;
+    } else if (a.result == MPP_STREAM_DONE) {
+        t->state = MPP_STREAM_TOP_DONE;
+    }
+    strm_dbg(s, "top pts %lld -> state %d fd %d at %lld\n", (long long)t->pts,
+             t->state, t->buf_fd, (long long)t->time_us);
+    return MPP_OK;
+}
+
+/* MPP_DEC_SET_STREAM_APPEND, on the caller's thread */
+static MPP_RET h265d_strm_append(HalH265dCtx *reg_ctx, MppDecStreamAppend *a)
+{
+    H265dStrm *s = (H265dStrm *)reg_ctx->strm;
+    MPP_RET ret = MPP_OK;
+
+    if (!s)
+        return MPP_NOK;
+    if (!a)
+        return MPP_OK;
+    if (a->flags & MPP_STREAM_APPEND_STOP) {
+        /* MPP's own, at a reset or stop (mpp_dec_stream_stop) */
+        pthread_mutex_lock(&s->lock);
+        strm_dbg(s, "stop: open %u pts %lld\n", s->open, (long long)s->pts);
+        s->stopping = 1;
+        if (s->open)
+            h265d_strm_send(reg_ctx, s, NULL, 0, MPP_STREAM_APPEND_LAST);
+        pthread_mutex_unlock(&s->lock);
+        return MPP_OK;
+    }
+    if (a->size && !a->data)
+        return MPP_ERR_NULL_PTR;
+
+    pthread_mutex_lock(&s->lock);
+    strm_dbg(s, "append pts %lld size %u flags %x: open %u pts %lld newest %lld\n",
+             (long long)a->pts, a->size, a->flags, s->open, (long long)s->pts,
+             (long long)s->newest_pts);
+    if (s->open && a->pts == s->pts) {
+        h265d_strm_send(reg_ctx, s, a->data, a->size, a->flags);
+    } else if (!s->opened_any || a->pts > s->newest_pts) {
+        /* its picture is not on the decoder yet */
+        H265dStrmPart *p;
+
+        if (s->open) {
+            /* the one that is gets no more: its caller has moved on */
+            strm_dbg(s, "pts %lld ended by a part of pts %lld\n",
+                     (long long)s->pts, (long long)a->pts);
+            h265d_strm_send(reg_ctx, s, NULL, 0, MPP_STREAM_APPEND_LAST);
+        }
+        if (s->pending_cnt == STRM_PENDING_MAX) {
+            if (++s->dropped <= 3 || !(s->dropped % 1000))
+                mpp_err("h265d: %d stream parts wait for their pictures: the oldest dropped (%u so far)\n",
+                        STRM_PENDING_MAX, s->dropped);
+            MPP_FREE(s->pending[0].data);
+            memmove(&s->pending[0], &s->pending[1], sizeof(s->pending[0]) * (STRM_PENDING_MAX - 1));
+            s->pending_cnt--;
+        }
+        p = &s->pending[s->pending_cnt];
+        p->pts = a->pts;
+        p->size = a->size;
+        p->flags = a->flags;
+        p->data = NULL;
+        if (a->size) {
+            p->data = mpp_malloc(RK_U8, a->size);
+            if (!p->data)
+                ret = MPP_ERR_MALLOC;
+            else
+                memcpy(p->data, a->data, a->size);
+        }
+        if (!ret)
+            s->pending_cnt++;
+    } else {
+        /* its picture is done, or was never streamed */
+        s->late++;
+        ret = MPP_NOK;
+    }
+    pthread_mutex_unlock(&s->lock);
+
+    return ret;
+}
