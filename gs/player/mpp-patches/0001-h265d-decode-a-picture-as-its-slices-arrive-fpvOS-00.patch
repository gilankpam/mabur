index f264bb0..b05c95c 100644
--- a/mpp/codec/inc/mpp_dec.h
+++ b/mpp/codec/inc/mpp_dec.h
@@ -51,6 +51,7 @@ MPP_RET mpp_dec_stop(MppDec ctx);
