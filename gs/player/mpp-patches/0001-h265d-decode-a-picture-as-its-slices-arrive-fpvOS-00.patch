diff --git a/inc/rk_vdec_cmd.h b/inc/rk_vdec_cmd.h
index fc333d5..09fc92a 100644
--- a/inc/rk_vdec_cmd.h
+++ b/inc/rk_vdec_cmd.h
@@ -66,4 +66,48 @@ typedef struct MppDecQueryCfg_t {
 typedef void* MppExtCbCtx;
 typedef MPP_RET (*MppExtCbFunc)(MppExtCbCtx cb_ctx, MppCtx mpp, RK_S32 cmd, void *arg);
 
+/*
+ * fpvOS: pictures decoded as their slices arrive (H.265, RK3568).
+ *
+ * A packet flagged MPP_PACKET_FLAG_STREAM_START holds the first slice(s) of
+ * a picture of MPP_PACKET_STREAM_SLICES(n) slices in all; the decoder starts
+ * on it at once. The rest follows by MPP_DEC_SET_STREAM_APPEND, one slice at
+ * a time, Annex-B start code included, the picture named by the packet's
+ * pts; the last with MPP_STREAM_APPEND_LAST. An append with no data and that
+ * flag ends a picture whose rest is lost. Appends may come before the decoder
+ * has taken the packet: they wait for it.
+ */
+#define MPP_PACKET_FLAG_STREAM_START    (0x00100000)
+#define MPP_PACKET_STREAM_SLICES(n)     ((((RK_U32)(n)) & 0xff) << 24)
+#define MPP_PACKET_STREAM_SLICES_OF(f)  ((((RK_U32)(f)) >> 24) & 0xff)
+
+#define MPP_STREAM_APPEND_LAST          (0x00000001)
+
+typedef struct MppDecStreamAppend_t {
+    const void  *data;
+    RK_U32      size;
+    RK_U32      flags;
+    RK_S64      pts;
+} MppDecStreamAppend;
+
+/*
+ * MPP_DEC_GET_STREAM_TOP: pts and timeout_ms in; state out - READY with
+ * buf_fd the picture's output buffer (the one its frame will come out in)
+ * and time_us when what it has was decoded (CLOCK_MONOTONIC), DONE if it
+ * finished first (its frame follows the usual way), NONE if neither came in
+ * time or the picture was never streamed.
+ */
+#define MPP_STREAM_TOP_NONE             (0)
+#define MPP_STREAM_TOP_READY            (1)
+#define MPP_STREAM_TOP_DONE             (2)
+
+typedef struct MppDecStreamTop_t {
+    RK_S64      pts;
+    RK_S32      timeout_ms;
+    RK_S32      state;
+    RK_S32      buf_fd;
+    RK_S64      time_us;
+} MppDecStreamTop;
+
+
 #endif /* RK_VDEC_CMD_H */
