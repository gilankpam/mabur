diff --git a/mpp/codec/mpp_dec.c b/mpp/codec/mpp_dec.c
index b63293b..bb0c697 100644
--- a/mpp/codec/mpp_dec.c
+++ b/mpp/codec/mpp_dec.c
@@ -849,6 +849,24 @@ MPP_RET mpp_dec_start(MppDec ctx)
     return ret;
 }
 
+/*
+ * A reset or a stop waits for the decoder, and a streamed picture still open
+ * there holds it until the kernel's deadline (rk_vcodec.rkvdec2_stream_wait_ms,
+ * 400 ms) for parts that are not coming: the caller resets because its input
+ * stalled. End that picture first, and any that opens before the hal is reset.
+ */
+static void mpp_dec_stream_stop(MppDecImpl *dec)
+{
+    MppDecStreamAppend a;
+
+    if (NULL == dec->hal || dec->coding != MPP_VIDEO_CodingHEVC)
+        return;
+
+    memset(&a, 0, sizeof(a));
+    a.flags = MPP_STREAM_APPEND_LAST | MPP_STREAM_APPEND_STOP;
+    mpp_hal_control(dec->hal, MPP_DEC_SET_STREAM_APPEND, &a);
+}
+
 MPP_RET mpp_dec_stop(MppDec ctx)
 {
     MPP_RET ret = MPP_OK;
@@ -856,6 +874,8 @@ MPP_RET mpp_dec_stop(MppDec ctx)
 
     dec_dbg_func("%p in\n", dec);
 
+    mpp_dec_stream_stop(dec);
+
     if (dec->thread_parser)
         mpp_thread_stop(dec->thread_parser);
 
@@ -888,6 +908,8 @@ MPP_RET mpp_dec_reset(MppDec ctx)
 
     dec_dbg_func("%p in\n", dec);
 
+    mpp_dec_stream_stop(dec);
+
     if (dec->api && dec->api->reset)
         ret = dec->api->reset(dec);
 
@@ -976,6 +998,32 @@ MPP_RET mpp_dec_control(MppDec ctx, MpiCmd cmd, void *param)
     return ret;
 }
 
+/*
+ * MPP_DEC_SET_STREAM_APPEND and MPP_DEC_GET_STREAM_TOP go straight to the hal,
+ * on the caller's thread: a control through mpp_dec_control waits for the
+ * decode thread, and that one may be waiting for the very picture an append
+ * completes.
+ */
+MPP_RET mpp_dec_stream_control(MppDec ctx, MpiCmd cmd, void *param)
+{
+    MppDecImpl *dec = (MppDecImpl *)ctx;
+
+    if (NULL == dec || NULL == dec->hal)
+        return MPP_ERR_NULL_PTR;
+
+    /* MPP_STREAM_APPEND_STOP is MPP's own: a caller's append is just an append */
+    if (cmd == MPP_DEC_SET_STREAM_APPEND && param &&
+        (((MppDecStreamAppend *)param)->flags & MPP_STREAM_APPEND_STOP)) {
+        MppDecStreamAppend a = *(MppDecStreamAppend *)param;
+
+        a.flags &= ~MPP_STREAM_APPEND_STOP;
+        return mpp_hal_control(dec->hal, cmd, &a);
+    }
+
+    return mpp_hal_control(dec->hal, cmd, param);
+}
+
+
 MPP_RET mpp_dec_set_cfg_by_cmd(MppDecCfg cfg, MpiCmd cmd, void *param)
 {
     MppDecCfgSet *dst = (MppDecCfgSet *)kmpp_obj_to_entry(cfg);
