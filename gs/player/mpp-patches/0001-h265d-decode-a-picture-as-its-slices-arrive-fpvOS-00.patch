diff --git a/test/mpi_dec_stream_test.c b/test/mpi_dec_stream_test.c
new file mode 100644
index 0000000..62b88ec
--- /dev/null
+++ b/test/mpi_dec_stream_test.c
@@ -0,0 +1,301 @@
+/*
+ * fpvOS: decode an H.265 Annex-B file picture by picture, each picture either
+ * whole or streamed - its first slice as a packet flagged
+ * MPP_PACKET_FLAG_STREAM_START, the others by MPP_DEC_SET_STREAM_APPEND after a
+ * delay, standing in for the radio - and write every picture out, errors
+ * included. Times the last slice (or the whole picture) to the frame.
+ *
+ *   mpi_dec_stream_test in.h265 out.yuv [stream 0|1] [gap_us] [lose_every] [top 0|1]
+ *
+ * lose_every N drops the last slice of every Nth picture, which then ends by
+ * an empty last append; with a negative N nothing ends it, and the kernel's
+ * wait (rk_vcodec.rkvdec2_stream_wait_ms) has to. top 1 asks, after each
+ * first slice, when the decoder has decoded it (MPP_DEC_GET_STREAM_TOP).
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "rk_mpi.h"
+
+#define MAX_PICS    4096
+#define MAX_SLICES  16
+
+typedef struct {
+    size_t      off[MAX_SLICES];    /* each slice, start code included */
+    size_t      len[MAX_SLICES];
+    int         n;
+    size_t      ps_off, ps_len;     /* parameter sets before the picture */
+} Pic;
+
+static RK_S64 now_us(void)
+{
+    struct timespec ts;
+
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000000LL + ts.tv_nsec / 1000;
+}
+
+static RK_S64 done_at[MAX_PICS];   /* when the picture was all given to MPP */
+static RK_S64 out_at[MAX_PICS];
+static int frames_out, frames_err;
+static FILE *fo;
+static MppCtx ctx;
+static MppApi *mpi;
+static volatile int stop;
+static int lose_no_end;
+static RK_S64 top_lat[MAX_PICS];
+static int ntop, top_ready, top_done, top_none;
+
+static void *out_thread(void *arg)
+{
+    (void)arg;
+    while (!stop) {
+        MppFrame f = NULL;
+
+        if (mpi->decode_get_frame(ctx, &f) || !f) {
+            usleep(1000);
+            continue;
+        }
+        if (mpp_frame_get_info_change(f)) {
+            mpi->control(ctx, MPP_DEC_SET_INFO_CHANGE_READY, NULL);
+        } else {
+            RK_S64 pts = mpp_frame_get_pts(f);
+            MppBuffer b = mpp_frame_get_buffer(f);
+
+            if (pts >= 0 && pts < MAX_PICS)
+                out_at[pts] = now_us();
+            if (mpp_frame_get_errinfo(f) || mpp_frame_get_discard(f))
+                frames_err++;
+            if (b && fo) {
+                RK_U32 w = mpp_frame_get_width(f), h = mpp_frame_get_height(f);
+                RK_U32 hs = mpp_frame_get_hor_stride(f), vs = mpp_frame_get_ver_stride(f);
+                RK_U8 *p = (RK_U8 *)mpp_buffer_get_ptr(b);
+                RK_U32 y;
+
+                for (y = 0; y < h; y++)
+                    fwrite(p + y * hs, 1, w, fo);
+                for (y = 0; y < h / 2; y++)
+                    fwrite(p + hs * vs + y * hs, 1, w, fo);
+            }
+            frames_out++;
+            if (mpp_frame_get_eos(f))
+                stop = 1;
+        }
+        mpp_frame_deinit(&f);
+    }
+    return NULL;
+}
+
+static void put(const void *data, size_t len, RK_S64 pts, RK_U32 flag)
+{
+    MppPacket pkt = NULL;
+
+    mpp_packet_init(&pkt, (void *)data, len);
+    mpp_packet_set_pts(pkt, pts);
+    if (flag)
+        mpp_packet_set_flag(pkt, flag);
+    while (mpi->decode_put_packet(ctx, pkt))
+        usleep(200);
+    mpp_packet_deinit(&pkt);
+}
+
+static int cmp_s64(const void *a, const void *b)
+{
+    RK_S64 x = *(const RK_S64 *)a, y = *(const RK_S64 *)b;
+
+    return x < y ? -1 : x > y;
+}
+
+int main(int argc, char **argv)
+{
+    static Pic pics[MAX_PICS];
+    int stream, gap_us, lose_every, npics = 0, i, k;
+    RK_U8 *buf, *tmp;
+    size_t size, pos, ps_off = 0, ps_len = 0;
+    FILE *fi;
+    pthread_t th;
+    RK_U32 v;
+    MppDecCfg cfg = NULL;
+    RK_S64 lat[MAX_PICS];
+    int nlat = 0;
+    int want_top;
+
+    if (argc < 3) {
+        fprintf(stderr, "usage: %s in.h265 out.yuv [stream 0|1] [gap_us] [lose_every]\n", argv[0]);
+        return 1;
+    }
+    stream = argc > 3 ? atoi(argv[3]) : 1;
+    gap_us = argc > 4 ? atoi(argv[4]) : 5000;
+    lose_every = argc > 5 ? atoi(argv[5]) : 0;
+    want_top = argc > 6 ? atoi(argv[6]) : 0;
+    {
+        int no_end = lose_every < 0;
+
+        if (no_end)
+            lose_every = -lose_every;
+        lose_no_end = no_end;
+    }
+
+    fi = fopen(argv[1], "rb");
+    if (!fi)
+        return 1;
+    fseek(fi, 0, SEEK_END);
+    size = ftell(fi);
+    fseek(fi, 0, SEEK_SET);
+    buf = malloc(size + 16);
+    tmp = malloc(size + 16);
+    if (fread(buf, 1, size, fi) != size)
+        return 1;
+    fclose(fi);
+
+    /* NALs by 4-byte start codes, grouped into pictures */
+    pos = 0;
+    while (pos + 4 < size) {
+        size_t end = pos + 4;
+        int type, first;
+
+        while (end + 4 <= size && memcmp(buf + end, "\0\0\0\1", 4))
+            end++;
+        if (end + 4 > size)
+            end = size;
+        type = (buf[pos + 4] >> 1) & 63;
+        first = buf[pos + 6] >> 7;
+        if (type >= 32 && type <= 34) {
+            if (!ps_len)
+                ps_off = pos;
+            ps_len = end - ps_off;
+        } else if (type <= 21) {
+            if (first) {
+                if (npics == MAX_PICS)
+                    break;
+                pics[npics].n = 0;
+                pics[npics].ps_off = ps_off;
+                pics[npics].ps_len = ps_len;
+                ps_len = 0;
+                npics++;
+            }
+            if (npics && pics[npics - 1].n < MAX_SLICES) {
+                Pic *p = &pics[npics - 1];
+
+                p->off[p->n] = pos;
+                p->len[p->n] = end - pos;
+                p->n++;
+            }
+        }
+        pos = end;
+    }
+
+    fo = fopen(argv[2], "wb");
+    if (mpp_create(&ctx, &mpi))
+        return 1;
+    /* before init: the hal streams only without fast mode, and decides at init */
+    v = 0;
+    mpi->control(ctx, MPP_DEC_SET_PARSER_FAST_MODE, &v);
+    mpi->control(ctx, MPP_DEC_SET_PARSER_SPLIT_MODE, &v);
+    if (mpp_init(ctx, MPP_CTX_DEC, MPP_VIDEO_CodingHEVC))
+        return 1;
+    mpp_dec_cfg_init(&cfg);
+    mpi->control(ctx, MPP_DEC_GET_CFG, cfg);
+    mpp_dec_cfg_set_u32(cfg, "base:split_parse", 0);
+    mpp_dec_cfg_set_u32(cfg, "base:fast_parse", 0);
+    mpp_dec_cfg_set_u32(cfg, "base:disable_error", 1);
+    mpi->control(ctx, MPP_DEC_SET_CFG, cfg);
+    v = 1;
+    mpi->control(ctx, MPP_DEC_SET_IMMEDIATE_OUT, &v);
+    if (stream && mpi->control(ctx, MPP_DEC_SET_STREAM_APPEND, NULL)) {
+        printf("no stream mode here: decoding whole pictures\n");
+        stream = 0;
+    }
+    pthread_create(&th, NULL, out_thread, NULL);
+
+    for (i = 0; i < npics; i++) {
+        Pic *p = &pics[i];
+        int lose = lose_every && (i % lose_every) == lose_every - 1 && p->n > 1;
+        size_t n0 = p->ps_len;
+
+        memcpy(tmp, buf + p->ps_off, p->ps_len);
+        if (!stream || p->n < 2) {
+            for (k = 0; k < p->n; k++) {
+                memcpy(tmp + n0, buf + p->off[k], p->len[k]);
+                n0 += p->len[k];
+            }
+            put(tmp, n0, i, 0);
+            done_at[i] = now_us();
+        } else {
+            RK_S64 sent;
+
+            memcpy(tmp + n0, buf + p->off[0], p->len[0]);
+            put(tmp, n0 + p->len[0], i,
+                MPP_PACKET_FLAG_STREAM_START | MPP_PACKET_STREAM_SLICES(p->n));
+            sent = now_us();
+            if (want_top) {
+                MppDecStreamTop t;
+
+                memset(&t, 0, sizeof(t));
+                t.pts = i;
+                t.timeout_ms = 20;
+                mpi->control(ctx, MPP_DEC_GET_STREAM_TOP, &t);
+                if (t.state == MPP_STREAM_TOP_READY) {
+                    top_ready++;
+                    top_lat[ntop++] = t.time_us - sent;
+                } else if (t.state == MPP_STREAM_TOP_DONE) {
+                    top_done++;
+                } else {
+                    top_none++;
+                }
+            }
+            for (k = 1; k < p->n; k++) {
+                MppDecStreamAppend a;
+                int last = k == p->n - 1;
+
+                usleep(gap_us / (p->n - 1));
+                a.pts = i;
+                if (last && lose && lose_no_end)
+                    break;
+                if (last && lose) {
+                    a.data = NULL;
+                    a.size = 0;
+                } else {
+                    a.data = buf + p->off[k];
+                    a.size = p->len[k];
+                }
+                a.flags = last ? MPP_STREAM_APPEND_LAST : 0;
+                if (mpi->control(ctx, MPP_DEC_SET_STREAM_APPEND, &a))
+                    printf("picture %d: slice %d not taken\n", i, k);
+            }
+            done_at[i] = now_us();
+        }
+        /* one picture at a time, as from the air: wait for it */
+        while (!out_at[i] && now_us() - done_at[i] < 200000)
+            usleep(100);
+        if (out_at[i])
+            lat[nlat++] = out_at[i] - done_at[i];
+    }
+    usleep(100000);
+    stop = 1;
+    pthread_join(th, NULL);
+
+    qsort(lat, nlat, sizeof(lat[0]), cmp_s64);
+    printf("%s: %d pictures, %d frames out (%d flagged with errors); "
+           "all given -> frame: median %lld us, p90 %lld us, max %lld us\n",
+           stream ? "streamed" : "whole", npics, frames_out, frames_err,
+           nlat ? (long long)lat[nlat / 2] : -1LL,
+           nlat ? (long long)lat[nlat * 9 / 10] : -1LL,
+           nlat ? (long long)lat[nlat - 1] : -1LL);
+
+    if (want_top) {
+        qsort(top_lat, ntop, sizeof(top_lat[0]), cmp_s64);
+        printf("top half: %d ready, %d done first, %d neither; first slice sent -> top half decoded: "
+               "median %lld us, max %lld us\n", top_ready, top_done, top_none,
+               ntop ? (long long)top_lat[ntop / 2] : -1LL, ntop ? (long long)top_lat[ntop - 1] : -1LL);
+    }
+
+    mpi->reset(ctx);
+    mpp_destroy(ctx);
+    fclose(fo);
+    return 0;
+}
-- 
