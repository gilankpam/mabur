+++ b/inc/rk_mpi_cmd.h
@@ -105,6 +105,19 @@ typedef enum {
     MPP_DEC_SET_DISABLE_DPB_CHECK,      /* disable dpb discontinuous check */
     MPP_DEC_SET_CODEC_MODE,             /* select codec mode */
     MPP_DEC_SET_DIS_ERR_CLR_MARK,
