{
    "backend": "mpp",
    "screen_mode": "1920x1080@60",
    "dvr": {
        "enabled": true,
        "dir": "/media/dvr",
        "fragment_ms": 1000,
        "mode": "burned",
        "burned": {
            "bitrate_kbps": 8000,
            "fps_cap": 60
        }
    },
    "osd": {
        "enable": true,
        "port": 14560,
        "font": "/usr/local/share/mabur/font_btfl.mfont",
        "scale": "sharp",
        "stale_ms": 5000,
        "gs": {
            "enable": false,
            "port": 8302,
            "font": "/usr/local/share/mabur/gs_osd.gfont",
            "stale_ms": 3000
        }
    }
}